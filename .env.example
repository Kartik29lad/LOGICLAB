# ==============================================================================
# LogicLab — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production credentials into version control.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Database (Microsoft SQL Server)
# Example connection string: Server=localhost,1433;Database=LogicLab;User Id=sa;Password=YourPassword123!;TrustServerCertificate=true;
DATABASE_URL=Server=localhost,1433;Database=LogicLab;User Id=sa;Password=PlaceholderPassword;TrustServerCertificate=true;

# Session & Authentication (Phase 15 - Placeholders)
SESSION_SECRET=placeholder_session_secret_min_32_characters_long

# Telemetry / Observability (Placeholder)
LOG_LEVEL=info
