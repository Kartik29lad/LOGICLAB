{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "arrowParens": "always",
  "embeddedLanguageFormatting": "off",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder":
    [
      "^(react/(.*)$)|^(react$)",
      "^(next/(.*)$)|^(next$)",
      "<THIRD_PARTY_MODULES>",
      "",
      "^@/config/(.*)$",
      "^@/contracts/(.*)$",
      "^@/core/(.*)$",
      "^@/errors/(.*)$",
      "^@/lib/(.*)$",
      "^@/types/(.*)$",
      "^@/observability/(.*)$",
      "^@/server/(.*)$",
      "^@/content/(.*)$",
      "^@/components/(.*)$",
      "^@/features/(.*)$",
      "^@/hooks/(.*)$",
      "^@/styles/(.*)$",
      "^@/(.*)$",
      "",
      "^[./]",
    ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
}
